# Loader: use a separate privileged DATABASE_URL only in your terminal.
# App: use a SELECT-only login, never the loader's database owner.
DATABASE_URL=postgresql://sales_reader:CHANGE_ME@localhost:5432/sales?sslmode=require
APP_DB_SCHEMA=sales_analytics
HASHED_PASSWORD=
# Optional: manual SQL works without Gemini.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
